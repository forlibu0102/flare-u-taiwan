---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Resources"><section><p>OFFICIAL LINKS</p><h1>Resources</h1><h2>資源頁面整理中</h2><span>官方連結與實用資源將顯示於此。</span></section></Layout>
<style>:global(body){margin:0;color:#0d1b3d;font-family:Inter,"Noto Sans TC",system-ui,sans-serif}section{min-height:70vh;padding:120px max(24px,calc((100% - 1200px)/2));background:radial-gradient(circle at 80% 15%,rgba(13,27,61,.11),transparent 30%),#fafcff}p{color:#438fe9;font-size:.75rem;font-weight:750;letter-spacing:.18em}h1{margin:20px 0;font-size:clamp(3.6rem,9vw,7rem);letter-spacing:-.07em}h2{font-size:1.6rem}span{color:#667085}</style>
