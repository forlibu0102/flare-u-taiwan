---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FLARE U 專輯" description="FLARE U 專輯總覽，查看各張專輯的簡介、完整曲目、官方 MV 與收聽平台。">
  <section class="album-index" id="page-top">
    <div class="page-inner">
      <p class="eyebrow">DISCOGRAPHY</p>
      <div class="heading-row"><h1>專輯</h1><p>選擇專輯，查看專輯簡介、完整曲目與各平台收聽連結。</p></div>
      <div class="album-grid" data-album-grid>
        <a class="album-card" href="/albums/detail?album=YOUTH%20ERROR">
          <img src="/images/albums/youth-error.jpg" alt="FLARE U YOUTH ERROR 專輯封面" />
          <div><p class="card-label">1ST MINI ALBUM</p><h2>YOUTH ERROR</h2><p>2026.05.13</p><span>查看專輯資訊 →</span></div>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  *{box-sizing:border-box}.album-index{min-height:75vh;padding:92px 24px 120px;background:radial-gradient(circle at 90% 10%,rgba(32,199,201,.13),transparent 30%),#f7faff;color:#0d1b3d}.page-inner{width:min(1160px,100%);margin:0 auto}.eyebrow,.card-label{margin:0;color:#438fe9;font-size:.74rem;font-weight:800;letter-spacing:.18em}.heading-row{margin:12px 0 46px}.heading-row h1{margin:0;font-size:clamp(4rem,9vw,7rem);letter-spacing:-.07em;line-height:.9}.heading-row>p{max-width:620px;margin:24px 0 0;color:#667085;line-height:1.8}.album-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.album-card{display:grid;grid-template-columns:minmax(180px,280px) 1fr;align-items:center;gap:36px;padding:30px;border:1px solid #dfe6f0;border-radius:32px;background:#fff;color:#0d1b3d;text-decoration:none;box-shadow:0 20px 55px rgba(13,27,61,.07);transition:transform .2s ease,border-color .2s ease}.album-card:hover{transform:translateY(-5px);border-color:#438fe9}.album-card img{display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:22px}.album-card h2{margin:12px 0;font-size:clamp(2rem,4vw,3.4rem);line-height:.95;letter-spacing:-.055em}.album-card div>p:not(.card-label){margin:0;color:#667085}.album-card span{display:inline-block;margin-top:28px;color:#438fe9;font-weight:800}@media(max-width:900px){.album-grid{grid-template-columns:1fr}}@media(max-width:650px){.album-index{padding:68px 20px 88px}.heading-row>p{margin-top:18px}.album-card{grid-template-columns:110px 1fr;gap:20px;padding:18px;border-radius:24px}.album-card img{border-radius:16px}.album-card h2{font-size:1.65rem}.album-card span{margin-top:18px;font-size:.86rem}}
  html[data-theme="dark"] .album-index{background:#081225;color:#eef4fb}html[data-theme="dark"] .heading-row h1,html[data-theme="dark"] .album-card h2{color:#f3f7fc}html[data-theme="dark"] .heading-row>p,html[data-theme="dark"] .album-card div>p:not(.card-label){color:#b7c3d5}html[data-theme="dark"] .album-card{border-color:#2d405e;background:#11213b;color:#eef4fb}
</style>

<script>
  type Album = {name:string;albumType:string;releaseDate:string;coverUrl:string};
  const grid=document.querySelector<HTMLElement>('[data-album-grid]');
  const make=<K extends keyof HTMLElementTagNameMap>(tag:K,className='',text='')=>{const el=document.createElement(tag);if(className)el.className=className;if(text)el.textContent=text;return el;};
  fetch('/api/albums').then(response=>response.ok?response.json():[]).then((albums:Album[])=>{
    if(!grid||!Array.isArray(albums)||!albums.length)return;
    grid.replaceChildren(...albums.map(album=>{
      const card=make('a','album-card');card.href=`/albums/detail?album=${encodeURIComponent(album.name)}`;
      const image=make('img');image.src=album.coverUrl||'/images/albums/youth-error.jpg';image.alt=`FLARE U ${album.name} 專輯封面`;
      const copy=make('div');copy.append(make('p','card-label',album.albumType||'ALBUM'),make('h2','',album.name),make('p','',album.releaseDate),make('span','','查看專輯資訊 →'));card.append(image,copy);return card;
    }));
  }).catch(()=>{});
</script>
