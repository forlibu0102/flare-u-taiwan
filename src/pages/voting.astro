---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Voting" description="FLARE U 目前投票、投票教學與應援資訊">
  <section class="page-hero">
    <div class="page-inner hero-grid">
      <div>
        <p class="eyebrow">投票中心</p>
        <h1>Support<br />FLARE U.</h1>
        <p class="lead">集中整理目前進行中的投票、截止時間與參與方式，讓每一票都不錯過。</p>
      </div>
      <div class="status-panel" aria-live="polite" aria-busy="true" data-deadline-panel>
        <span class="status-dot"></span>
        <p>即將截止</p>
        <strong data-deadline-title>投票資料載入中…</strong>
        <span data-deadline-time></span>
      </div>
    </div>
  </section>

  <section class="voting-content">
    <div class="page-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">目前投票</p>
          <h2>目前投票</h2>
        </div>
        <span class="count-pill" data-vote-count>0 項進行中</span>
      </div>

      <div class="vote-list" data-vote-list></div>
      <div class="empty-state" data-empty-state>
        <div class="empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m8.5 11 2.3 2.3 4.8-5M5 15.5h14v5H5v-5Zm2-12h10a2 2 0 0 1 2 2v10H5v-10a2 2 0 0 1 2-2Z" /></svg>
        </div>
        <p class="empty-label">暫無投票</p>
        <h3>目前沒有進行中的投票</h3>
        <p>新的投票資訊公布後，會在這裡提供平台、截止時間與完整步驟。</p>
      </div>
    </div>
  </section>

  <section class="community-section">
    <div class="page-inner">
      <div class="community-card">
        <div class="community-mark" aria-hidden="true">LINE</div>
        <div class="community-copy">
          <p class="eyebrow">VOTING COMMUNITY</p>
          <h2>VOTE FOR FLARE U</h2>
          <p>加入 LINE 投票社群，及時掌握投票提醒、票數變化與最新應援資訊。</p>
        </div>
        <a class="community-link" href="https://line.me/ti/g2/1zFtX6bx32L0kOAaepgBfmz3RH_f1aduJ_7upw?utm_source=invitation&amp;utm_medium=link_copy&amp;utm_campaign=default" target="_blank" rel="noreferrer">
          加入 LINE 社群 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #0d1b3d; font-family: Inter, "Noto Sans TC", system-ui, sans-serif; }
  .page-inner { width: min(1200px, 100%); margin: 0 auto; }
  .page-hero { padding: 104px 24px 116px; background: radial-gradient(circle at 85% 12%, rgba(32,199,201,.18), transparent 29%), radial-gradient(circle at 8% 88%, rgba(67,143,233,.15), transparent 30%), #fafcff; }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(300px,420px); align-items: end; gap: 70px; }
  .eyebrow { margin: 0; color: #438fe9; font-size: .75rem; font-weight: 750; letter-spacing: .18em; }
  h1 { max-width: 750px; margin: 22px 0 26px; font-size: clamp(4rem, 9vw, 7.8rem); line-height: .86; letter-spacing: -.07em; }
  .lead { max-width: 610px; margin: 0; color: #667085; font-size: 1.06rem; line-height: 1.8; }
  .status-panel { position: relative; padding: 30px; border: 1px solid rgba(216,225,238,.9); border-radius: 25px; background: rgba(255,255,255,.86); box-shadow: 0 22px 60px rgba(13,27,61,.09); backdrop-filter: blur(16px); }
  .status-panel p { margin: 0 0 13px; color: #7d899c; font-size: .78rem; font-weight: 700; letter-spacing: .12em; }
  .status-panel strong { display: block; font-size: 1.45rem; }
  .status-panel > span:last-child { display: block; margin-top: 8px; color: #667085; }
  .status-dot { position: absolute; top: 30px; right: 30px; width: 10px; height: 10px; border-radius: 50%; background: #20c7c9; box-shadow: 0 0 0 7px rgba(32,199,201,.12); }
  .voting-content, .community-section { padding: 96px 24px; }
  .community-section { background:linear-gradient(180deg,#fff 0%,#f7faff 100%); }
  .community-card { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:28px; padding:36px; border:1px solid #dce7e3; border-radius:28px; background:radial-gradient(circle at 92% 8%,rgba(6,199,85,.14),transparent 28%),#fff; box-shadow:0 20px 55px rgba(13,27,61,.07); }
  .community-mark { display:grid; width:78px; height:78px; place-items:center; border-radius:24px; background:#06c755; color:#fff; font-size:.86rem; font-weight:850; letter-spacing:.04em; box-shadow:0 13px 30px rgba(6,199,85,.22); }
  .community-copy h2 { margin:8px 0 10px; font-size:clamp(1.9rem,3.6vw,3.1rem); }
  .community-copy>p:last-child { max-width:660px; margin:0; color:#667085; line-height:1.7; }
  .community-link { display:inline-flex; align-items:center; justify-content:center; gap:9px; padding:15px 20px; border-radius:999px; background:#06c755; color:#fff; font-weight:800; text-decoration:none; white-space:nowrap; transition:transform .2s ease,box-shadow .2s ease; }
  .community-link:hover { transform:translateY(-2px); box-shadow:0 12px 28px rgba(6,199,85,.23); }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  h2 { margin: 10px 0 0; font-size: clamp(2.4rem,5vw,4.2rem); letter-spacing: -.05em; }
  .count-pill { padding: 10px 15px; border-radius: 999px; background: #eef6ff; color: #438fe9; font-size: .75rem; font-weight: 750; letter-spacing: .1em; }
  .empty-state { display: flex; align-items: center; flex-direction: column; padding: 66px 28px; border: 1px solid #dfe6f0; border-radius: 28px; background: radial-gradient(circle at 80% 20%,rgba(32,199,201,.12),transparent 26%),#fff; text-align: center; box-shadow: 0 20px 55px rgba(13,27,61,.07); }
  .empty-icon { display: grid; width: 66px; height: 66px; place-items: center; border-radius: 20px; background: #eef6ff; color: #438fe9; }
  .empty-icon svg { width: 34px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .empty-label { margin: 25px 0 0; color: #438fe9 !important; font-size: .72rem; font-weight: 750; letter-spacing: .18em; }
  .empty-state h3 { margin: 10px 0; font-size: clamp(1.6rem,3vw,2.25rem); }
  .empty-state p { max-width: 560px; margin: 0; color: #667085; line-height: 1.7; }
  .empty-state a { display: inline-flex; gap: 9px; margin-top: 28px; padding: 14px 20px; border-radius: 999px; background: #0d1b3d; color: #fff; font-weight: 700; text-decoration: none; }
  .vote-list { display:grid; gap:18px; }
  :global(.vote-card) { position:relative; overflow:hidden; padding:34px; border:1px solid #dfe6f0; border-radius:28px; background:radial-gradient(circle at 94% 4%,rgba(32,199,201,.15),transparent 27%),linear-gradient(145deg,#fff 0%,#fbfdff 100%); box-shadow:0 20px 55px rgba(13,27,61,.08); }
  :global(.vote-card::after) { position:absolute; top:0; left:0; width:100%; height:4px; background:linear-gradient(90deg,#438fe9,#20c7c9); content:""; }
  :global(.vote-topline) { display:flex; align-items:center; justify-content:space-between; gap:16px; }
  :global(.vote-status) { display:inline-flex; align-items:center; gap:7px; padding:8px 12px; border-radius:999px; background:#e9fbfa; color:#159d9f; font-size:.7rem; font-weight:800; letter-spacing:.08em; }
  :global(.vote-status::before) { width:7px; height:7px; border-radius:50%; background:#20c7c9; content:""; box-shadow:0 0 0 5px rgba(32,199,201,.12); }
  :global(.vote-countdown) { padding:8px 12px; border-radius:999px; background:#fff0f1; color:#d94d5b; font-size:.8rem; font-weight:800; }
  :global(.vote-card h3) { max-width:850px; margin:26px 0 16px; font-size:clamp(1.55rem,3vw,2.35rem); line-height:1.25; letter-spacing:-.025em; }
  :global(.platform-label) { margin:0 0 10px; color:#7d899c; font-size:.69rem; font-weight:800; letter-spacing:.12em; }
  :global(.platform-list) { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 26px; padding:0; list-style:none; }
  :global(.platform-list li) { padding:8px 12px; border:1px solid #dbe8fa; border-radius:999px; background:#eef5ff; color:#367fd2; font-size:.76rem; font-weight:750; }
  :global(.vote-meta) { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  :global(.vote-metric) { min-height:108px; padding:20px; border:1px solid #e1e8f1; border-radius:20px; background:rgba(250,252,255,.9); }
  :global(.vote-metric span) { display:block; margin-bottom:12px; color:#7d899c; font-size:.68rem; font-weight:750; letter-spacing:.1em; }
  :global(.vote-metric strong) { color:#0d1b3d; font-size:clamp(1.4rem,2.5vw,2rem); letter-spacing:-.03em; }
  :global(.vote-details) { display:grid; gap:7px; margin-top:22px; padding-top:20px; border-top:1px solid #e5ebf3; color:#667085; line-height:1.65; }
  :global(.vote-actions) { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
  :global(.vote-actions a) { display:inline-flex; padding:13px 18px; border-radius:999px; background:#0d1b3d; color:#fff; font-size:.88rem; font-weight:750; text-decoration:none; transition:transform .2s ease,background .2s ease; }
  :global(.vote-actions a:hover) { transform:translateY(-2px); background:#2563eb; }
  :global(.vote-actions a.secondary) { background:#eef5ff; color:#2563eb; }
  @media (max-width: 800px) { .page-hero { padding: 72px 24px 80px; } .hero-grid { grid-template-columns: 1fr; gap: 40px; } h1 { font-size: clamp(4rem,20vw,6rem); } .voting-content,.community-section { padding: 72px 24px; }.community-card{grid-template-columns:auto minmax(0,1fr)}.community-link{grid-column:1/-1;width:100%} }
  @media (max-width: 700px) { :global(.vote-meta){grid-template-columns:1fr}:global(.vote-card){padding:27px 22px}:global(.vote-topline){align-items:flex-start;flex-direction:column}:global(.vote-countdown){font-size:.78rem} }
  @media (max-width: 520px) { .section-heading { align-items: flex-start; flex-direction: column; } .status-panel { padding: 24px; } .empty-state { padding: 48px 22px; }.community-card{grid-template-columns:1fr;padding:28px 24px}.community-mark{width:66px;height:66px;border-radius:20px}.community-link{grid-column:auto} }
</style>

<script>
  type Vote = {
    title: string;
    platforms: string[];
    start: string | null;
    end: string;
    rank: string;
    votes: string;
    gap: string;
    updatedAt: string;
    voteUrl: string;
    appStoreUrl: string;
    googlePlayUrl: string;
    method: string;
    note: string;
  };

  const list = document.querySelector<HTMLElement>('[data-vote-list]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const count = document.querySelector<HTMLElement>('[data-vote-count]');
  const deadlinePanel = document.querySelector<HTMLElement>('[data-deadline-panel]');
  const deadlineTitle = document.querySelector<HTMLElement>('[data-deadline-title]');
  const deadlineTime = document.querySelector<HTMLElement>('[data-deadline-time]');
  const dateTimeFormatter = new Intl.DateTimeFormat('zh-TW', {
    timeZone: 'Asia/Taipei', month: 'long', day: 'numeric', weekday: 'short',
    hour: 'numeric', minute: '2-digit', hour12: true,
  });

  function countdown(end: string) {
    const remaining = new Date(end).getTime() - Date.now();
    if (remaining <= 0) return '已截止';
    const totalMinutes = Math.floor(remaining / 60000);
    const days = Math.floor(totalMinutes / 1440);
    const hours = Math.floor((totalMinutes % 1440) / 60);
    const minutes = totalMinutes % 60;
    if (days > 0) return `剩下 ${days} 天 ${hours} 小時`;
    if (hours > 0) return `剩下 ${hours} 小時 ${minutes} 分`;
    return `剩下 ${minutes} 分`;
  }

  function metric(label: string, value: string) {
    const item = document.createElement('div');
    item.className = 'vote-metric';
    const caption = document.createElement('span');
    caption.textContent = label;
    const data = document.createElement('strong');
    data.textContent = value;
    item.append(caption, data);
    return item;
  }

  function action(label: string, url: string, secondary = false) {
    const link = document.createElement('a');
    link.href = url;
    link.target = '_blank';
    link.rel = 'noreferrer';
    link.textContent = `${label} ↗`;
    if (secondary) link.className = 'secondary';
    return link;
  }

  function gapMetric(rank: string, gap: string) {
    const numericRank = Number(rank.replace(/^#/, ''));
    const numericGap = Number(gap.replace(/,/g, ''));
    if (numericRank === 1 || numericGap === 0) return metric('票數狀態', '目前第一');
    if (!Number.isFinite(numericGap)) return metric('與第一名差距', '待更新');
    if (numericGap < 0) return metric('距離第一名', `差 ${Math.abs(numericGap).toLocaleString('zh-TW')} 票`);
    return metric('領先第二名', `${numericGap.toLocaleString('zh-TW')} 票`);
  }

  function renderVote(vote: Vote) {
    const card = document.createElement('article');
    card.className = 'vote-card';
    const top = document.createElement('div');
    top.className = 'vote-topline';
    const status = document.createElement('span');
    status.className = 'vote-status';
    status.textContent = vote.start && new Date(vote.start) > new Date() ? '即將開始' : '進行中';
    const timer = document.createElement('span');
    timer.className = 'vote-countdown';
    timer.dataset.countdown = vote.end;
    timer.textContent = countdown(vote.end);
    top.append(status, timer);

    const heading = document.createElement('h3');
    heading.textContent = vote.title;
    const platformLabel = document.createElement('p');
    platformLabel.className = 'platform-label';
    platformLabel.textContent = '投票平台';
    const platforms = document.createElement('ul');
    platforms.className = 'platform-list';
    vote.platforms.forEach((platform) => {
      const item = document.createElement('li');
      item.textContent = platform;
      platforms.append(item);
    });

    const meta = document.createElement('div');
    meta.className = 'vote-meta';
    if (vote.rank) meta.append(metric('目前名次', `#${vote.rank.replace(/^#/, '')}`));
    if (vote.votes) meta.append(metric('目前票數', Number(vote.votes.replace(/,/g, '')).toLocaleString('zh-TW')));
    if (vote.gap || vote.rank.replace(/^#/, '') === '1') meta.append(gapMetric(vote.rank, vote.gap));

    const details = document.createElement('div');
    details.className = 'vote-details';
    const deadline = document.createElement('span');
    deadline.textContent = `截止時間：${dateTimeFormatter.format(new Date(vote.end))}`;
    details.append(deadline);
    [vote.method, vote.note, vote.updatedAt ? `資料更新：${vote.updatedAt}` : ''].filter(Boolean).forEach((text) => {
      const line = document.createElement('span');
      line.textContent = text;
      details.append(line);
    });

    const actions = document.createElement('div');
    actions.className = 'vote-actions';
    if (vote.voteUrl) actions.append(action('前往投票', vote.voteUrl));
    if (vote.appStoreUrl) actions.append(action('App Store', vote.appStoreUrl, true));
    if (vote.googlePlayUrl) actions.append(action('Google Play', vote.googlePlayUrl, true));

    card.append(top, heading, platformLabel, platforms);
    if (meta.childElementCount) card.append(meta);
    card.append(details);
    if (actions.childElementCount) card.append(actions);
    return card;
  }

  async function loadVotes() {
    try {
      const response = await fetch('/api/votes');
      if (!response.ok) throw new Error('Voting request failed');
      const votes: Vote[] = await response.json();
      if (count) count.textContent = `${votes.length} 項進行中`;
      if (!votes.length) {
        if (deadlineTitle) deadlineTitle.textContent = '目前沒有即將截止的投票';
        if (deadlineTime) deadlineTime.textContent = '新的投票資訊公布後將顯示於此';
        return;
      }

      emptyState?.remove();
      if (deadlineTitle) deadlineTitle.textContent = votes[0].title;
      if (deadlineTime) deadlineTime.textContent = `${countdown(votes[0].end)} · ${dateTimeFormatter.format(new Date(votes[0].end))}`;
      votes.forEach((vote) => list?.append(renderVote(vote)));
      window.setInterval(() => {
        document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((element) => {
          if (element.dataset.countdown) element.textContent = countdown(element.dataset.countdown);
        });
      }, 60000);
    } catch {
      if (deadlineTitle) deadlineTitle.textContent = '投票資料暫時無法載入';
      if (deadlineTime) deadlineTime.textContent = '請稍後再試';
    } finally {
      deadlinePanel?.setAttribute('aria-busy', 'false');
    }
  }

  loadVotes();
</script>
