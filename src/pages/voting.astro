---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Voting" description="FLARE U 目前投票、投票教學與應援資訊">
  <section class="page-hero">
    <div class="page-inner hero-grid">
      <div>
        <p class="eyebrow">投票中心</p>
        <h1>Support<br />FLARE U.</h1>
        <p class="lead">集中整理目前進行中的投票、截止時間與參與方式，讓每一票都不錯過。</p>
      </div>
      <div class="status-panel">
        <span class="status-dot"></span>
        <p>即將截止</p>
        <strong>目前沒有即將截止的投票</strong>
        <span>最近截止的投票將顯示於此</span>
      </div>
    </div>
  </section>

  <section class="voting-content">
    <div class="page-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">目前投票</p>
          <h2>目前投票</h2>
        </div>
        <span class="count-pill">0 項進行中</span>
      </div>

      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m8.5 11 2.3 2.3 4.8-5M5 15.5h14v5H5v-5Zm2-12h10a2 2 0 0 1 2 2v10H5v-10a2 2 0 0 1 2-2Z" /></svg>
        </div>
        <p class="empty-label">暫無投票</p>
        <h3>目前沒有進行中的投票</h3>
        <p>新的投票資訊公布後，會在這裡提供平台、截止時間與完整步驟。</p>
      </div>
    </div>
  </section>

  <section class="guide-section">
    <div class="page-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">參與方式</p>
          <h2>投票參與方式</h2>
        </div>
      </div>
      <div class="steps-grid">
        <article><span>01</span><h3>確認投票</h3><p>查看進行中的項目、平台與截止時間。</p></article>
        <article><span>02</span><h3>閱讀教學</h3><p>依照步驟準備帳號、App 或投票券。</p></article>
        <article><span>03</span><h3>完成應援</h3><p>完成投票並留意每日重置與追加機會。</p></article>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #0d1b3d; font-family: Inter, "Noto Sans TC", system-ui, sans-serif; }
  .page-inner { width: min(1200px, 100%); margin: 0 auto; }
  .page-hero { padding: 104px 24px 116px; background: radial-gradient(circle at 85% 12%, rgba(32,199,201,.18), transparent 29%), radial-gradient(circle at 8% 88%, rgba(67,143,233,.15), transparent 30%), #fafcff; }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(300px,420px); align-items: end; gap: 70px; }
  .eyebrow { margin: 0; color: #438fe9; font-size: .75rem; font-weight: 750; letter-spacing: .18em; }
  h1 { max-width: 750px; margin: 22px 0 26px; font-size: clamp(4rem, 9vw, 7.8rem); line-height: .86; letter-spacing: -.07em; }
  .lead { max-width: 610px; margin: 0; color: #667085; font-size: 1.06rem; line-height: 1.8; }
  .status-panel { position: relative; padding: 30px; border: 1px solid rgba(216,225,238,.9); border-radius: 25px; background: rgba(255,255,255,.86); box-shadow: 0 22px 60px rgba(13,27,61,.09); backdrop-filter: blur(16px); }
  .status-panel p { margin: 0 0 13px; color: #7d899c; font-size: .78rem; font-weight: 700; letter-spacing: .12em; }
  .status-panel strong { display: block; font-size: 1.45rem; }
  .status-panel > span:last-child { display: block; margin-top: 8px; color: #667085; }
  .status-dot { position: absolute; top: 30px; right: 30px; width: 10px; height: 10px; border-radius: 50%; background: #20c7c9; box-shadow: 0 0 0 7px rgba(32,199,201,.12); }
  .voting-content, .guide-section { padding: 96px 24px; }
  .guide-section { background: linear-gradient(180deg,#fff 0%,#f7faff 100%); }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  h2 { margin: 10px 0 0; font-size: clamp(2.4rem,5vw,4.2rem); letter-spacing: -.05em; }
  .count-pill { padding: 10px 15px; border-radius: 999px; background: #eef6ff; color: #438fe9; font-size: .75rem; font-weight: 750; letter-spacing: .1em; }
  .empty-state { display: flex; align-items: center; flex-direction: column; padding: 66px 28px; border: 1px solid #dfe6f0; border-radius: 28px; background: radial-gradient(circle at 80% 20%,rgba(32,199,201,.12),transparent 26%),#fff; text-align: center; box-shadow: 0 20px 55px rgba(13,27,61,.07); }
  .empty-icon { display: grid; width: 66px; height: 66px; place-items: center; border-radius: 20px; background: #eef6ff; color: #438fe9; }
  .empty-icon svg { width: 34px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .empty-label { margin: 25px 0 0; color: #438fe9 !important; font-size: .72rem; font-weight: 750; letter-spacing: .18em; }
  .empty-state h3 { margin: 10px 0; font-size: clamp(1.6rem,3vw,2.25rem); }
  .empty-state p { max-width: 560px; margin: 0; color: #667085; line-height: 1.7; }
  .empty-state a { display: inline-flex; gap: 9px; margin-top: 28px; padding: 14px 20px; border-radius: 999px; background: #0d1b3d; color: #fff; font-weight: 700; text-decoration: none; }
  .steps-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
  .steps-grid article { min-height: 205px; padding: 28px; border: 1px solid #dfe6f0; border-radius: 24px; background: #fff; }
  .steps-grid span { color: #438fe9; font-size: .75rem; font-weight: 750; }
  .steps-grid h3 { margin: 34px 0 8px; font-size: 1.35rem; }
  .steps-grid p { margin: 0; color: #667085; line-height: 1.65; }
  @media (max-width: 800px) { .page-hero { padding: 72px 24px 80px; } .hero-grid { grid-template-columns: 1fr; gap: 40px; } h1 { font-size: clamp(4rem,20vw,6rem); } .voting-content,.guide-section { padding: 72px 24px; } .steps-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .section-heading { align-items: flex-start; flex-direction: column; } .status-panel { padding: 24px; } .empty-state { padding: 48px 22px; } }
</style>
