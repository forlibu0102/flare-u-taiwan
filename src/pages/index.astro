---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="FLARE U Taiwan"
	description="FLARE U 台灣資訊整合站｜投票、行程、影音與完整指南"
>
	<!-- Hero -->
	<section class="hero">
		<div class="hero-content">
			<div class="hero-copy">
				<p class="eyebrow">TAIWAN FAN HUB</p>

				<h1>
					Every FLARE U Moment.<br />
					All in One Place.
				</h1>

				<p class="hero-description">
					由台灣 U'RE 建立，整理 FLARE U 的團體資訊、投票、行程與影音內容。
				</p>

				<div class="hero-actions">
					<a class="primary-button" href="/voting">查看目前投票</a>
					<a class="secondary-button" href="/events">查看最新行程</a>
				</div>
			</div>

			<figure class="hero-photo">
				<img
					src="/images/hero/IMG_6223.png"
					alt="FLARE U 成員一起製作手作作品"
					width="2048"
					height="1152"
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
		</div>
	</section>

	<!-- 即時摘要 -->
	<section class="summary-section">
		<div class="section-inner summary-grid">
			<article class="summary-card summary-card--blue">
				<div class="card-heading">
					<p class="card-label">SINCE DEBUT</p>
					<span class="card-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M12 2.8c.8 4.8 2.4 6.4 7.2 7.2-4.8.8-6.4 2.4-7.2 7.2-.8-4.8-2.4-6.4-7.2-7.2 4.8-.8 6.4-2.4 7.2-7.2Z" /></svg>
					</span>
				</div>
				<p class="card-value">
					<span id="debut-days">—</span>
					<span class="card-unit">天</span>
				</p>
				<p class="card-note">2026.05.13 正式出道</p>
			</article>

			<a class="summary-card summary-card--navy" href="/voting" aria-label="前往目前投票">
				<div class="card-heading">
					<p class="card-label">目前投票</p>
					<span class="card-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="m8.5 11 2.3 2.3 4.8-5M5 15.5h14v5H5v-5Zm2-12h10a2 2 0 0 1 2 2v10H5v-10a2 2 0 0 1 2-2Z" /></svg>
					</span>
				</div>
				<p class="card-value">
					<span id="current-vote-count">—</span>
					<span class="card-unit">項</span>
				</p>
				<p class="card-note" id="current-vote-note">投票資料載入中…</p>
			</a>

			<a class="summary-card summary-card--aqua" href="/events" aria-label="前往下一行程">
				<div class="card-heading">
					<p class="card-label">下一行程</p>
					<span class="card-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M7 2.5v3M17 2.5v3M4 8.5h16M5 4.5h14a1 1 0 0 1 1 1v14H4v-14a1 1 0 0 1 1-1Zm3 8h3v3H8v-3Z" /></svg>
					</span>
				</div>
				<p class="event-name" id="next-event-name">行程載入中…</p>
				<p class="card-note" id="next-event-time"></p>
			</a>
		</div>
	</section>

	<!-- What's New -->
	<section class="content-section news-section" data-announcement-section>
		<div class="section-inner">
			<div class="section-heading">
				<div>
					<p class="section-label">LATEST UPDATE</p>
					<h2>What’s New</h2>
				</div>

				<a class="text-link" data-announcement-link href="https://flareu.jp/feature/entry" target="_blank" rel="noreferrer">前往日本官網 →</a>
			</div>

			<div class="news-list" data-announcement-list>
			<a class="news-item" data-announcement-item href="https://flareu.jp/feature/entry" target="_blank" rel="noreferrer">
				<time class="news-date" datetime="2026-09-12T22:59:00+09:00">
					<span>2026</span>
					<strong>09.12</strong>
				</time>

				<div class="news-copy">
					<p class="news-category">JAPAN OFFICIAL MEMBERSHIP</p>
					<h3>FLARE U 1st 日本官方付費會員招募中</h3>
					<p>招募截止：2026 年 9 月 12 日（六）22:59</p>
				</div>

				<span class="news-arrow" aria-hidden="true">↗</span>
			</a>
			</div>
		</div>
	</section>

	<!-- Quick Access -->
	<section class="content-section quick-section">
		<div class="section-inner">
			<div class="section-heading">
				<div>
					<p class="section-label">快速探索</p>
					<h2>快速入口</h2>
				</div>
			</div>

			<div class="quick-grid">
				<a class="quick-card quick-card--about" href="/about">
					<div class="quick-card-top">
						<span class="quick-number">01</span>
						<span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0" /></svg></span>
					</div>
					<div class="quick-copy">
						<h3>關於 FLARE U</h3>
						<p>認識 FLARE U 與官方社群</p>
					</div>
					<span class="quick-arrow">↗</span>
				</a>

				<a class="quick-card quick-card--voting" href="/voting">
					<div class="quick-card-top">
						<span class="quick-number">02</span>
						<span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m8.5 11 2.3 2.3 4.8-5M5 15.5h14v5H5v-5Zm2-12h10a2 2 0 0 1 2 2v10H5v-10a2 2 0 0 1 2-2Z" /></svg></span>
					</div>
					<div class="quick-copy">
						<h3>投票專區</h3>
						<p>目前投票與完整教學</p>
					</div>
					<span class="quick-arrow">↗</span>
				</a>

				<a class="quick-card quick-card--events" href="/events">
					<div class="quick-card-top">
						<span class="quick-number">03</span>
						<span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 2.5v3M17 2.5v3M4 8.5h16M5 4.5h14a1 1 0 0 1 1 1v14H4v-14a1 1 0 0 1 1-1Zm3 8h3v3H8v-3Z" /></svg></span>
					</div>
					<div class="quick-copy">
						<h3>行程資訊</h3>
						<p>最新官方活動與行程</p>
					</div>
					<span class="quick-arrow">↗</span>
				</a>

				<a class="quick-card quick-card--media" href="/media">
					<div class="quick-card-top">
						<span class="quick-number">04</span>
						<span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3V9Z" /></svg></span>
					</div>
					<div class="quick-copy">
						<h3>影音專區</h3>
						<p>官方影片與舞台整理</p>
					</div>
					<span class="quick-arrow">↗</span>
				</a>
			</div>
		</div>
	</section>

	<script>
		const debutDate = new Date('2026-05-13T00:00:00+08:00');
		const today = new Date();

		const millisecondsPerDay = 1000 * 60 * 60 * 24;
		const elapsedDays = Math.floor(
			(today.getTime() - debutDate.getTime()) / millisecondsPerDay
		);

		const debutDays = Math.max(1, elapsedDays + 1);
		const debutDaysElement = document.querySelector('#debut-days');

		if (debutDaysElement) {
			debutDaysElement.textContent = debutDays.toLocaleString('zh-TW');
		}

		const voteCount = document.querySelector('#current-vote-count');
		const voteNote = document.querySelector('#current-vote-note');
		const eventName = document.querySelector('#next-event-name');
		const eventTime = document.querySelector('#next-event-time');
		const eventDateFormatter = new Intl.DateTimeFormat('zh-TW', {
			timeZone: 'Asia/Taipei',
			month: 'long',
			day: 'numeric',
			weekday: 'short',
		});
		const eventTimeFormatter = new Intl.DateTimeFormat('zh-TW', {
			timeZone: 'Asia/Taipei',
			hour: 'numeric',
			minute: '2-digit',
			hour12: true,
		});

		async function loadVotingSummary() {
			try {
				const response = await fetch('/api/votes');
				if (!response.ok) throw new Error('Voting request failed');
				const votes = await response.json();
				if (voteCount) voteCount.textContent = String(votes.length);
				if (voteNote) voteNote.textContent = votes.length
					? `最近截止：${votes[0].title}`
					: '目前沒有進行中的投票';
			} catch {
				if (voteCount) voteCount.textContent = '—';
				if (voteNote) voteNote.textContent = '投票資料暫時無法載入';
			}
		}

		async function loadEventSummary() {
			try {
				const response = await fetch('/api/next-event');
				if (!response.ok) throw new Error('Event request failed');
				const event = await response.json();
				if (!event) {
					if (eventName) eventName.textContent = '目前沒有已公布行程';
					if (eventTime) eventTime.textContent = '';
					return;
				}

				const startsAt = new Date(event.start);
				const endsAt = new Date(event.end);
				if (eventName) eventName.textContent = event.title;
				if (eventTime) eventTime.textContent = event.allDay
					? `${eventDateFormatter.format(startsAt)} · 全天`
					: `${eventDateFormatter.format(startsAt)} · ${eventTimeFormatter.format(startsAt)}－${eventTimeFormatter.format(endsAt)}`;
			} catch {
				if (eventName) eventName.textContent = '行程暫時無法載入';
				if (eventTime) eventTime.textContent = '請稍後再試';
			}
		}

		async function loadAnnouncements() {
			const section = document.querySelector('[data-announcement-section]');
			const list = document.querySelector('[data-announcement-list]');
			const template = document.querySelector('[data-announcement-item]');
			const headerLink = document.querySelector('[data-announcement-link]');
			if (!section || !list || !template) return;
			try {
				const response = await fetch('/api/announcements');
				if (!response.ok) throw new Error('Announcement request failed');
				const announcements = await response.json();
				if (!Array.isArray(announcements) || !announcements.length) {
					section.remove();
					return;
				}

				const items = announcements.map((announcement) => {
					const item = template.cloneNode(true);
					item.href = announcement.url;
					const time = item.querySelector('time');
					if (time) {
						time.dateTime = announcement.dateTime;
						time.querySelector('span').textContent = announcement.year;
						time.querySelector('strong').textContent = announcement.monthDay;
					}
					item.querySelector('.news-category').textContent = announcement.category;
					item.querySelector('h3').textContent = announcement.title;
					item.querySelector('.news-copy > p:last-child').textContent = announcement.description;
					return item;
				});
				list.replaceChildren(...items);
				if (headerLink) {
					headerLink.href = announcements[0].url;
					headerLink.textContent = `${announcements[0].linkText} →`;
				}
			} catch {}
		}

		loadVotingSummary();
		loadEventSummary();
		loadAnnouncements();
	</script>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		background: #ffffff;
		color: #0d1b3d;
		font-family:
			Inter, "Noto Sans TC", system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
	}

	.hero {
		position: relative;
		min-height: 680px;
		display: flex;
		align-items: center;
		padding: 96px 24px;
		overflow: hidden;
		background:
			radial-gradient(
				circle at 82% 20%,
				rgba(95, 227, 211, 0.2),
				transparent 30%
			),
			radial-gradient(
				circle at 12% 75%,
				rgba(74, 140, 255, 0.16),
				transparent 32%
			),
			#fafcff;
	}

	.hero-content,
	.section-inner {
		width: min(1200px, 100%);
		margin: 0 auto;
	}

	.hero-content {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 488px;
	}

	.hero-content::after {
		position: absolute;
		z-index: 1;
		inset: -96px;
		background: linear-gradient(
			90deg,
			#fafcff 0%,
			rgba(250, 252, 255, 0.98) 30%,
			rgba(250, 252, 255, 0.86) 46%,
			rgba(250, 252, 255, 0.28) 65%,
			transparent 82%
		);
		content: "";
		pointer-events: none;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		width: min(690px, 62%);
	}

	.hero-photo {
		position: absolute;
		z-index: 0;
		top: -96px;
		right: -120px;
		bottom: -96px;
		left: 34%;
		margin: 0;
		border: 0;
		border-radius: 0;
		background: #e9e6df;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 24%, #000 100%);
		mask-image: linear-gradient(to right, transparent 0%, #000 24%, #000 100%);
	}

	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 56% 62%;
	}

	.eyebrow,
	.section-label,
	.card-label {
		margin: 0;
		color: #438fe9;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	h1 {
		max-width: 920px;
		margin: 24px 0;
		font-size: clamp(3.5rem, 8vw, 7.5rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.hero-description {
		max-width: 590px;
		margin: 0;
		color: #667085;
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 36px;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 22px;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 650;
		transition:
			transform 180ms ease,
			background-color 180ms ease;
	}

	.primary-button {
		background: #0d1b3d;
		color: #ffffff;
	}

	.secondary-button {
		border: 1px solid #d8dee9;
		background: rgba(255, 255, 255, 0.72);
		color: #0d1b3d;
	}

	.primary-button:hover,
	.secondary-button:hover {
		transform: translateY(-2px);
	}

	.summary-section {
		position: relative;
		z-index: 3;
		padding: 0 24px 20px;
		background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
	}

	.summary-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: -66px;
	}

	.summary-card {
		position: relative;
		min-width: 0;
		min-height: 205px;
		padding: 28px 30px 30px;
		border: 1px solid rgba(216, 225, 238, 0.9);
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 20px 55px rgba(13, 27, 61, 0.09);
		backdrop-filter: blur(18px);
		overflow: hidden;
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.summary-card::before {
		position: absolute;
		top: 0;
		left: 30px;
		width: 66px;
		height: 4px;
		border-radius: 0 0 999px 999px;
		background: var(--card-accent);
		content: "";
	}

	.summary-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 26px 65px rgba(13, 27, 61, 0.13);
	}

	.summary-card--blue {
		--card-accent: #438fe9;
		--card-soft: #eef6ff;
	}

	.summary-card--navy {
		--card-accent: #0d1b3d;
		--card-soft: #f0f3f8;
	}

	.summary-card--aqua {
		--card-accent: #20c7c9;
		--card-soft: #eafbf9;
	}

	.card-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	.card-icon {
		display: grid;
		flex: 0 0 auto;
		width: 42px;
		height: 42px;
		place-items: center;
		border-radius: 14px;
		background: var(--card-soft);
		color: var(--card-accent);
	}

	.card-icon svg {
		width: 23px;
		height: 23px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.summary-card--blue .card-icon svg {
		fill: currentColor;
		stroke: none;
	}

	.card-value {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin: 20px 0 7px;
		font-size: 3rem;
		font-weight: 760;
		letter-spacing: -0.05em;
	}

	.card-unit {
		font-size: 1rem;
		font-weight: 600;
	}

	.event-name {
		margin: 24px 0 12px;
		font-size: 1.45rem;
		font-weight: 700;
	}

	.card-note,
	.news-item p,
	.quick-card p {
		margin: 0;
		color: #667085;
		line-height: 1.6;
	}

	.content-section {
		padding: 112px 24px 0;
	}

	.news-section {
		padding-top: 76px;
	}

	.quick-section {
		padding-top: 100px;
		padding-bottom: 120px;
		background: linear-gradient(180deg, #ffffff 0%, #f7faff 100%);
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 32px;
	}

	h2 {
		margin: 10px 0 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		letter-spacing: -0.04em;
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		min-height: 42px;
		padding: 0 17px;
		border: 1px solid #dfe6f0;
		border-radius: 999px;
		background: #ffffff;
		color: inherit;
		text-decoration: none;
		color: #0d1b3d;
		text-decoration: none;
		font-weight: 650;
		transition: border-color 180ms ease, transform 180ms ease;
	}

	.text-link:hover {
		border-color: #9bb7df;
		transform: translateY(-2px);
	}

	.news-item {
		position: relative;
		display: grid;
		grid-template-columns: 118px minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(24px, 4vw, 54px);
		padding: 32px 34px;
		border: 1px solid #dfe6f0;
		border-radius: 26px;
		background:
			radial-gradient(circle at 92% 14%, rgba(32, 199, 201, 0.12), transparent 25%),
			linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
		box-shadow: 0 18px 50px rgba(13, 27, 61, 0.07);
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.news-list {
		display: grid;
		gap: 16px;
	}

	.news-item:hover {
		border-color: #b8cae4;
		box-shadow: 0 24px 60px rgba(13, 27, 61, 0.11);
		transform: translateY(-3px);
	}

	.news-date {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		justify-content: center;
		min-height: 102px;
		padding-left: 22px;
		border-left: 4px solid #438fe9;
		color: #438fe9;
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.16em;
	}

	.news-date strong {
		margin-top: 3px;
		color: #0d1b3d;
		font-size: 2rem;
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.news-category {
		color: #438fe9 !important;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.16em;
	}

	.news-item h3 {
		margin: 8px 0 8px;
		font-size: clamp(1.35rem, 2.5vw, 1.8rem);
		letter-spacing: -0.025em;
	}

	.news-arrow {
		display: grid;
		width: 52px;
		height: 52px;
		place-items: center;
		border-radius: 50%;
		background: #0d1b3d;
		color: #ffffff;
		font-size: 1.5rem;
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.news-item:hover .news-arrow {
		background: #438fe9;
		transform: rotate(8deg);
	}

	.quick-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.quick-card {
		position: relative;
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		min-height: 245px;
		padding: 30px;
		border: 1px solid #dfe6f0;
		border-radius: 26px;
		background:
			radial-gradient(circle at 92% 12%, var(--quick-glow), transparent 34%),
			#ffffff;
		box-shadow: 0 16px 45px rgba(13, 27, 61, 0.06);
		color: inherit;
		text-decoration: none;
