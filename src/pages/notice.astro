/* =========================
   手機版
   ========================= */

@media (max-width: 768px) {
  .notice-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 24px;
  }

  :global(.notice-card .info-list) {
    grid-template-columns: 1fr;
  }

  .notice-card {
    padding: 22px 20px;
    border-radius: 20px;
  }

  .notice-card .vote-title {
    font-size: 21px;
  }

  .notice-card .event-title {
    font-size: 20px;
  }
}
</style>

<script>
  const votesContainer = document.querySelector('[data-votes]');
  const params = new URLSearchParams(window.location.search);

const today = new Date();

const targetDate = params.get('date') || new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Taipei',
}).format(today);

const noticeDate = document.querySelector('[data-notice-date]');
const formattedDate = targetDate.slice(5).replace('-', '/');

if (noticeDate) {
  noticeDate.textContent = `${formattedDate} 提醒事項`;
}

document.title = `${formattedDate} 提醒事項`;
  const eventsContainer = document.querySelector('[data-events]');

  const timeZone = 'Asia/Taipei';

  const timeFormatter = new Intl.DateTimeFormat('zh-TW', {
    timeZone,
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });

  function showEmpty(container, message) {
    if (!container) return;

    const card = document.createElement('div');
    card.className = 'empty-card';
    card.textContent = message;

    container.replaceChildren(card);
  }

  
  function createVoteCard(vote) {
  const card = document.createElement('article');
  card.className = 'notice-card';

  if (Array.isArray(vote.platforms) && vote.platforms.length) {
    const meta = document.createElement('div');
    meta.className = 'meta';

    vote.platforms.forEach((platform) => {
      const tag = document.createElement('span');
      tag.textContent = platform;
      meta.appendChild(tag);
    });

    card.appendChild(meta);
  }

  const title = document.createElement('h3');
  title.className = 'vote-title';
  title.textContent = vote.title || '未命名投票';
  card.appendChild(title);

  const info = document.createElement('div');
  info.className = 'info-list';

  if (vote.end) {
    const end = document.createElement('div');
    end.innerHTML = `
      <strong>截止時間</strong>
      <span>${timeFormatter.format(new Date(vote.end))}</span>
    `;
    info.appendChild(end);
  }

  if (vote.rank) {
    const rank = document.createElement('div');
    rank.innerHTML = `
      <strong>目前排名</strong>
      <span>#${vote.rank}</span>
    `;
    info.appendChild(rank);
  }

  if (vote.votes) {
    const count = document.createElement('div');
    count.innerHTML = `
      <strong>目前票數</strong>
      <span>${vote.votes}</span>
    `;
    info.appendChild(count);
  }

  if (info.children.length) {
    card.appendChild(info);
  }

  if (vote.note) {
    const note = document.createElement('div');
    note.className = 'event-description';
    note.textContent = vote.note;
    card.appendChild(note);
  }

  if (vote.voteUrl) {
    const link = document.createElement('a');
    link.className = 'card-link';
    link.href = vote.voteUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = '前往投票 →';
    card.appendChild(link);
  }

  return card;
}
function createEventCard(event) {
  const card = document.createElement('article');
  card.className = 'notice-card';

  const time = document.createElement('div');
  time.className = 'event-time';

  if (event.allDay) {
    time.textContent = '全天行程';
  } else {
    const start = new Date(event.start);
    const end = new Date(event.end);

    time.textContent =
      `${timeFormatter.format(start)}－${timeFormatter.format(end)}`;
  }

  card.appendChild(time);

  const title = document.createElement('h3');
  title.className = 'event-title';
  title.textContent = event.title || '未命名行程';
  card.appendChild(title);

  if (event.description) {
    const description = document.createElement('div');
    description.className = 'event-description';
    description.textContent = event.description;
    card.appendChild(description);
  }

  return card;
}

  async function loadNotice() {
    try {
      const [votesResponse, eventsResponse] = await Promise.all([
        fetch(`/api/votes.js?date=${encodeURIComponent(targetDate)}`),
        fetch(`/api/next-event.js?date=${encodeURIComponent(targetDate)}`),
      ]);

      if (!votesResponse.ok) {
        throw new Error('Vote request failed');
      }

      if (!eventsResponse.ok) {
        throw new Error('Event request failed');
      }

      const votes = await votesResponse.json();
      const eventsData = await eventsResponse.json();

      const events = Array.isArray(eventsData?.events)
        ? eventsData.events
        : eventsData
          ? [eventsData]
          : [];

      if (Array.isArray(votes) && votes.length) {
        votesContainer?.replaceChildren(
          ...votes.map(createVoteCard)
        );
      } else {
        showEmpty(votesContainer, '明日目前沒有進行中的投票。');
      }

      if (events.length) {
        eventsContainer?.replaceChildren(
          ...events.map(createEventCard)
        );
      } else {
        showEmpty(eventsContainer, '明日目前沒有已公布行程。');
      }
    } catch (error) {
      console.error('Failed to load notice page:', error);

      showEmpty(votesContainer, '投票資訊暫時無法載入。');
      showEmpty(eventsContainer, '行程資訊暫時無法載入。');
    }
  }

  loadNotice();
</script>