---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="提醒事項"
  description="FLARE U Taiwan 提醒事項，整理投票與明日行程。"
>
  <main class="notice-page">
    <section class="notice-hero">
      <div class="page-inner">
        <p class="eyebrow">FLARE U TAIWAN</p>
        <h1>
  <span data-notice-date>提醒事項</span>
</h1>
        <p class="lead">
          集中整理明日的重要投票與行程，一頁掌握 FLARE U 的最新資訊。
        </p>
      </div>
    </section>

    <section class="notice-section voting-section">
      <div class="page-inner">
        <div class="section-heading">
          <p class="eyebrow">VOTING</p>
          <h2>投票</h2>
        </div>

        <div class="notice-grid" data-votes>
          <article class="notice-card loading-card">
            <span class="card-icon">🗳️</span>
            <strong>投票資訊載入中…</strong>
          </article>
        </div>
      </div>
    </section>

    <section class="notice-section events-section">
      <div class="page-inner">
        <div class="section-heading">
          <p class="eyebrow">SCHEDULE</p>
          <h2>明日行程</h2>
        </div>

        <div class="notice-grid" data-events>
          <article class="notice-card loading-card">
            <span class="card-icon">📅</span>
            <strong>行程資訊載入中…</strong>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: #0d1b3d;
    font-family: Inter, "Noto Sans TC", system-ui, sans-serif;
  }

  .page-inner {
    width: min(1100px, 100%);
    margin: 0 auto;
  }

  .notice-hero {
  padding: 92px 24px 82px;
  background:
    radial-gradient(circle at 84% 13%, rgba(32, 199, 201, 0.2), transparent 29%),
    radial-gradient(circle at 8% 88%, rgba(67, 143, 233, 0.15), transparent 30%),
    #fafcff;
}

[data-notice-date] {
  color: #10254a !important;
}

.notice-hero p {
  color: #536783 !important;
}

html[data-theme="dark"] .notice-hero {
  background:
    radial-gradient(circle at 84% 13%, rgba(32, 199, 201, 0.12), transparent 29%),
    radial-gradient(circle at 8% 88%, rgba(67, 143, 233, 0.12), transparent 30%),
    #081225;
}

html[data-theme="dark"] [data-notice-date] {
  color: #f3f7fc !important;
}

html[data-theme="dark"] .notice-hero p {
  color: #b7c3d5 !important;
}

.notice-hero p {
  color: #536783 !important;
}

  .eyebrow {
    margin: 0;
    color: #438fe9;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 20px 0 24px;
    font-size: clamp(3.8rem, 9vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .lead {
    max-width: 650px;
    margin: 0;
    color: #667085;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .notice-section {
    padding: 76px 24px;
  }

  .voting-section {
    background: #fff;
  }

  .events-section {
    background: linear-gradient(180deg, #f7faff 0%, #ffffff 100%);
  }

  .section-heading {
    margin-bottom: 30px;
  }

  .section-heading h2 {
    margin: 10px 0 0;
    font-size: clamp(2.4rem, 5vw, 4rem);
    letter-spacing: -0.05em;
  }

  .notice-grid {
    display: grid;
    gap: 18px;
  }

.notice-card {
  position: relative;
  padding: 28px 30px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      rgba(30, 57, 96, 0.95),
      rgba(18, 40, 73, 0.92)
    );
  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  overflow: hidden;
  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

:global(.notice-card) {
  position: relative;
  padding: 28px 30px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      rgba(30, 57, 96, 0.95),
      rgba(18, 40, 73, 0.92)
    );
  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  overflow: hidden;
  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

:global(.notice-card)::before {
  content: "";
  position: absolute;
  top: -70px;
  right: -50px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: rgba(76, 218, 210, 0.12);
  filter: blur(20px);
  pointer-events: none;
}

:global(.notice-card:hover) {
  transform: translateY(-4px);
  border-color: rgba(91, 191, 255, 0.24);
  box-shadow:
    0 22px 50px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}
.card-icon {
  font-size: 1.5rem;
}

.vote-title,
.event-title {
  margin: 0;
  color: #0d1b3d;
  font-size: 1.45rem;
  line-height: 1.45;
  letter-spacing: -0.02em;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.meta span {
  padding: 6px 11px;
  border: 1px solid #d8e6fb;
  border-radius: 999px;
  background: #eef5ff;
  color: #438fe9;
  font-size: 0.8rem;
  font-weight: 750;
}

.info-list {
  display: grid;
  gap: 0;
  margin-top: 22px;
  border-top: 1px solid #e5ebf3;
}

.info-list > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 13px 0;
  border-bottom: 1px solid #e5ebf3;
  color: #667085;
  line-height: 1.5;
}

.info-list strong {
  color: #7d899c;
  font-size: 0.88rem;
  font-weight: 650;
}

:global(.notice-card .card-link) {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  margin-top: 22px;
  padding: 11px 18px;
  border-radius: 999px;
  background: #4da9ff;
  color: #071326;
  font-size: 13px;
  font-weight: 800;
  line-height: 1;
  text-decoration: none;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

:global(.notice-card .card-link:hover) {
  transform: translateY(-2px);
  background: #6bb8ff;
  box-shadow: 0 8px 22px rgba(77, 169, 255, 0.24);
}

.card-link:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.empty-card {
  padding: 28px;
  border: 1px dashed #d5deeb;
  border-radius: 24px;
  color: #7d899c;
  background: rgba(255, 255, 255, 0.65);
}

.event-time {
  display: inline-flex;
  margin-bottom: 14px;
  padding: 7px 12px;
  border-radius: 999px;
  background: #eef5ff;
  color: #438fe9;
  font-size: 0.86rem;
  font-weight: 750;
}

.event-description {
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid #e5ebf3;
  color: #667085;
  line-height: 1.8;
  white-space: pre-line;
}
  @media (max-width: 600px) {
    .notice-hero {
      padding: 72px 20px 64px;
    }

    .notice-section {
      padding: 60px 20px;
    }

    h1 {
      font-size: clamp(3.5rem, 18vw, 5.5rem);
    }

    .notice-card {
      padding: 22px;
      border-radius: 20px;
    }
  }
