<script>
  type Milestone = {
    startDate: string;
    endDate: string;
    year: number;
    startMonth: number;
    startDay: number;
    endMonth: number;
    endDay: number;
    title: string;
    description: string;
    highlight: boolean;
  };

  function isUpcoming(endDate: string) {
    const [year, month, day] = endDate.split('-').map(Number);
    return Date.now() <= new Date(year, month - 1, day, 23, 59, 59).getTime();
  }

  function formatDate(item: Milestone) {
    const start = `${String(item.startMonth).padStart(2, '0')}.${String(item.startDay).padStart(2, '0')}`;
    if (item.startDate === item.endDate) return start;
    const end = item.startMonth === item.endMonth
      ? String(item.endDay).padStart(2, '0')
      : `${String(item.endMonth).padStart(2, '0')}.${String(item.endDay).padStart(2, '0')}`;
    return `${start}–${end}`;
  }

  async function loadMilestones() {
    const container = document.querySelector<HTMLElement>('#timeline-data');
    if (!container) return;
    try {
      const response = await fetch('/api/milestones');
      if (!response.ok) throw new Error('Unable to load milestones');
      const milestones = await response.json() as Milestone[];
      if (!milestones.length) return;

      const years = new Map<number, Milestone[]>();
      milestones.forEach((item) => years.set(item.year, [...(years.get(item.year) || []), item]));
      container.replaceChildren(...Array.from(years, ([year, items]) => {
        const section = document.createElement('div');
        section.className = 'timeline-year';
        const yearLabel = document.createElement('div');
        yearLabel.className = 'year-label';
        const label = document.createElement('span');
        label.textContent = 'YEAR';
        const yearText = document.createElement('strong');
        yearText.textContent = String(year);
        yearLabel.append(label, yearText);

        const list = document.createElement('ol');
        list.className = 'timeline-list';
        items.forEach((item) => {
          const entry = document.createElement('li');
          if (item.highlight) entry.className = 'highlight';
          const time = document.createElement('time');
          time.dateTime = item.startDate;
          time.textContent = formatDate(item);
          const content = document.createElement('div');
          const title = document.createElement('h3');
          title.textContent = item.title;
          content.append(title);
          if (item.description) {
            const description = document.createElement('p');
            description.textContent = item.description;
            content.append(description);
          }
          if (isUpcoming(item.endDate)) {
            const badge = document.createElement('span');
            badge.className = 'upcoming-badge';
            badge.textContent = '預定';
            content.append(badge);
          }
          entry.append(time, content);
          list.append(entry);
        });
        section.append(yearLabel, list);
        return section;
      }));
    } catch (error) {
      console.error(error);
    }
  }

  loadMilestones();
</script>

