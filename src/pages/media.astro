<Layout title="Media" description="FLARE U 官方影片、舞台與影音內容整理">
  <section class="page-hero">
    <div class="page-inner">
      <div>
        <p class="eyebrow">MEDIA ARCHIVE</p>
        <h1>Watch.<br />Listen.<br />FLARE U.</h1>
        <p class="lead">收藏 FLARE U 的官方影片、舞台與精彩片段，想看的內容都能快速找到。</p>
      </div>
    </div>
  </section>

  <section class="category-section">
    <div class="page-inner">
      <div class="section-heading category-heading">
        <div>
          <p class="eyebrow">VIDEO CATEGORIES</p>
          <h2>影音分類</h2>
          <p class="category-intro">整理作品、節目、電台與舞台內容；選擇分類後，以列表快速瀏覽。</p>
        </div>
      </div>

      <div class="category-tabs" role="tablist" aria-label="影音分類">
        {videoGroups.map((group, index) => (
          <button class:list={['category-tab', { active: index === 0 }]} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-category-button={group.id}>
            {group.label}<span>{String(group.videos.length).padStart(2, '0')}</span>
          </button>
        ))}
      </div>

      {videoGroups.map((group, groupIndex) => (
        <div class="video-group" data-category-panel={group.id} hidden={groupIndex !== 0}>
          <div class="group-title">
            <p class="eyebrow">{group.eyebrow}</p>
            <h3>{group.label}</h3>
          </div>
          <div class="video-list">
            {group.videos.map(([id, title], index) => (
              <a class="video-row" data-video-item data-page-index={Math.floor(index / 5)} hidden={index >= 5} href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noreferrer">
                <div class="video-thumb">
                  <img src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} alt="" loading="lazy" />
                  <span class="row-play" aria-hidden="true">▶</span>
                </div>
                <div class="video-info">
                  <p class="video-number">{String(index + 1).padStart(2, '0')} · YOUTUBE</p>
                  <h4>{title}</h4>
                  <p>開啟 YouTube 觀看完整影片</p>
                </div>
                <span class="watch-link">觀看影片 ↗</span>
              </a>
            ))}
          </div>
          {group.videos.length > 5 && (
            <nav class="video-pagination" aria-label={`${group.label}影片分頁`} data-pagination>
              {Array.from({ length: Math.ceil(group.videos.length / 5) }, (_, pageIndex) => (
                <button class:list={['page-button', { active: pageIndex === 0 }]} type="button" data-page-button={pageIndex} aria-label={`第 ${pageIndex + 1} 頁`} aria-current={pageIndex === 0 ? 'page' : undefined}>
                  {pageIndex + 1}
                </button>
              ))}
            </nav>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="media-section">
    <div class="page-inner">
      <div class="section-heading">
        <div>
          <p class="eyebrow">WATCH NOW</p>
          <h2>最新影音</h2>
        </div>
      </div>

      <div class="video-shell">
        <iframe
          src="https://www.youtube-nocookie.com/embed/videoseries?list=UUrHCkXuYLQyx90BtAuunKQg"
          title="FLARE U 官方 YouTube 最新影片"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="archive-section">
    <div class="page-inner archive-card">
      <div>
        <p class="eyebrow">OFFICIAL YOUTUBE</p>
        <h2>FLARE U 官方 YouTube</h2>
        <p class="archive-copy">追蹤官方頻道，第一時間觀看 FLARE U 的 MV、舞台、幕後花絮與最新影片。</p>
        <a class="channel-link" href="https://www.youtube.com/@flareu_official" target="_blank" rel="noreferrer">
          前往官方 YouTube <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="archive-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4V5Zm4 4 7 3-7 3V9Z" /></svg>
      </div>
    </div>
  </section>

  <section class="translation-section">
    <div class="page-inner">
      <div class="translation-heading">
        <p class="eyebrow">FAN-MADE TRANSLATION SITES</p>
        <h2>中文翻譯資源</h2>
        <p>以下網站由台灣粉絲經營，提供中文翻譯與影音整理，本站已取得連結收錄同意。</p>
      </div>
      <div class="translation-grid">
        <a class="translation-card" href="https://flareu-tw-trans.github.io/" target="_blank" rel="noreferrer">
          <span class="translation-label">非官方粉絲站</span>
          <h3>FLARE U 台灣翻譯站</h3>
          <p>FLARE U 中文翻譯與相關內容整理</p>
          <span class="translation-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="translation-card" href="https://chueiliyutwtrans.github.io/chueiliyu-tw-translation/" target="_blank" rel="noreferrer">
          <span class="translation-label">非官方粉絲站</span>
          <h3>崔立于台灣翻譯站</h3>
          <p>崔立于中文翻譯與相關內容整理</p>
          <span class="translation-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
