  .row-play { position:absolute; inset:50% auto auto 50%; display:grid; width:42px; height:42px; place-items:center; border-radius:50%; background:rgba(13,27,61,.86); color:#fff; font-size:.75rem; transform:translate(-50%,-50%); }
  .video-number { margin:0 0 8px; color:#438fe9; font-size:.7rem; font-weight:800; letter-spacing:.15em; }
  .video-info h4 { margin:0; font-size:1.2rem; line-height:1.4; }
  .video-info > p:last-child { margin:8px 0 0; color:#7a869b; font-size:.88rem; }
  .watch-link { padding:0 16px; color:#0d1b3d; font-weight:800; white-space:nowrap; }
  .video-pagination { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:8px; margin-top:28px; }
  .page-button { display:grid; width:40px; height:40px; place-items:center; border:1px solid #dbe4ef; border-radius:50%; background:#fff; color:#526078; font:inherit; font-size:.86rem; font-weight:800; cursor:pointer; transition:background .2s ease,color .2s ease,border-color .2s ease; }
  .page-button:hover { border-color:#438fe9; color:#438fe9; }
  .page-button.active { border-color:#0d1b3d; background:#0d1b3d; color:#fff; }
  .archive-card { display:flex; align-items:center; justify-content:space-between; gap:40px; min-height:270px; padding:44px; border:1px solid #dfe6f0; border-radius:30px; background:#fff; box-shadow:0 20px 55px rgba(13,27,61,.07); }
  .archive-copy { max-width:600px; margin:18px 0 0; color:#667085; line-height:1.75; }
  .channel-link { display:inline-flex; align-items:center; gap:10px; margin-top:26px; padding:14px 20px; border-radius:999px; background:#0d1b3d; color:#fff; font-weight:750; text-decoration:none; transition:transform .2s ease,background .2s ease; }
  .channel-link:hover { transform:translateY(-2px); background:#2563eb; }
  .archive-icon { display:grid; flex:0 0 auto; width:92px; height:92px; place-items:center; border-radius:28px; background:#f0f1ff; color:#6c7ee1; }
  .archive-icon svg { width:44px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linejoin:round; }
  @media (max-width:800px) { .page-hero{padding:72px 24px 80px}h1{font-size:clamp(3.7rem,18vw,5.8rem)}.media-section,.archive-section,.category-section,.translation-section{padding:72px 24px}.archive-card{align-items:flex-start;flex-direction:column}.video-row{grid-template-columns:150px minmax(0,1fr)}.watch-link{display:none}.translation-grid{grid-template-columns:1fr} }
  @media (max-width:520px) { .video-shell{border-radius:20px}.archive-card{padding:30px 24px}.archive-icon{width:72px;height:72px;border-radius:22px}.category-tabs{margin:28px 0 40px}.video-row{grid-template-columns:112px minmax(0,1fr);gap:14px;padding:10px;border-radius:17px}.video-thumb{border-radius:11px}.row-play{width:32px;height:32px}.video-info h4{font-size:.98rem}.video-info>p:last-child{display:none}.video-number{font-size:.61rem}.group-title h3{font-size:2rem}.translation-card{min-height:190px;padding:28px 64px 28px 24px;border-radius:22px} }
