  :global(main) { display:flex; flex-direction:column; }
  .page-inner { width: min(1200px,100%); margin: 0 auto; }
  .page-hero { order:1; padding:104px 24px 116px; background:radial-gradient(circle at 84% 13%,rgba(108,126,225,.18),transparent 29%),radial-gradient(circle at 8% 88%,rgba(67,143,233,.14),transparent 30%),#fafcff; }
  .eyebrow { margin:0; color:#438fe9; font-size:.75rem; font-weight:750; letter-spacing:.18em; }
  h1 { max-width:760px; margin:22px 0 26px; font-size:clamp(4rem,9vw,7.8rem); line-height:.84; letter-spacing:-.07em; }
  .lead { max-width:610px; margin:0; color:#667085; font-size:1.06rem; line-height:1.8; }
  .media-section,.archive-section,.translation-section { padding:96px 24px; }
  .media-section { order:2; }
  .category-section { order:3; padding:104px 24px; background:#f8fbff; }
  .archive-section { order:4; background:linear-gradient(180deg,#fff 0%,#f7f8ff 100%); }
  .translation-section { order:5; padding-bottom:112px; background:#f7f9fd; }
  .translation-heading { max-width:760px; margin-bottom:34px; }
  .translation-heading>p:last-child { margin:18px 0 0; color:#667085; line-height:1.75; }
  .translation-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .translation-card { position:relative; display:block; min-height:210px; padding:34px 76px 34px 34px; border:1px solid #dfe6f0; border-radius:28px; background:radial-gradient(circle at 88% 12%,rgba(32,199,201,.13),transparent 28%),#fff; color:#0d1b3d; text-decoration:none; box-shadow:0 18px 44px rgba(13,27,61,.06); transition:transform .2s ease,box-shadow .2s ease; }
  .translation-card:nth-child(2) { background:radial-gradient(circle at 88% 12%,rgba(67,143,233,.14),transparent 28%),#fff; }
  .translation-card:hover { transform:translateY(-3px); box-shadow:0 22px 48px rgba(13,27,61,.1); }
  .translation-label { display:inline-flex; padding:7px 10px; border-radius:999px; background:#e9fbfa; color:#159d9f; font-size:.68rem; font-weight:800; letter-spacing:.12em; }
  .translation-card h3 { margin:34px 0 10px; font-size:clamp(1.35rem,2.3vw,1.8rem); }
  .translation-card p { margin:0; color:#667085; line-height:1.65; }
  .translation-arrow { position:absolute; right:30px; bottom:30px; color:#438fe9; font-size:1.35rem; font-weight:800; }
  .section-heading { margin-bottom:32px; }
  h2 { margin:10px 0 0; font-size:clamp(2.4rem,5vw,4.2rem); letter-spacing:-.05em; }
  .video-shell { overflow:hidden; aspect-ratio:16/9; border:1px solid #dfe6f0; border-radius:30px; background:#0d1b3d; box-shadow:0 20px 55px rgba(13,27,61,.12); }
  .video-shell iframe { display:block; width:100%; height:100%; border:0; }
  .category-heading { display:flex; justify-content:space-between; gap:32px; }
  .category-intro { max-width:650px; margin:18px 0 0; color:#667085; line-height:1.75; }
  .category-tabs { display:flex; gap:10px; margin:38px 0 52px; padding-bottom:8px; overflow-x:auto; scrollbar-width:thin; }
  .category-tab { display:flex; align-items:center; gap:12px; flex:0 0 auto; padding:13px 17px; border:1px solid #dbe4ef; border-radius:999px; background:#fff; color:#526078; font:inherit; font-weight:750; cursor:pointer; }
  .category-tab span { display:grid; min-width:27px; height:27px; place-items:center; border-radius:999px; background:#f0f5fb; color:#438fe9; font-size:.7rem; }
  .category-tab.active { border-color:#0d1b3d; background:#0d1b3d; color:#fff; }
  .category-tab.active span { background:rgba(255,255,255,.14); color:#fff; }
  .group-title { margin-bottom:24px; }
  .group-title h3 { margin:9px 0 0; font-size:clamp(2rem,4vw,3.2rem); letter-spacing:-.04em; }
  .video-list { display:grid; gap:14px; }
  .video-row[hidden], .video-group[hidden] { display:none !important; }
  .video-row { display:grid; grid-template-columns:210px minmax(0,1fr) auto; align-items:center; gap:26px; padding:14px; border:1px solid #dfe6f0; border-radius:22px; background:#fff; color:inherit; text-decoration:none; transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease; }
