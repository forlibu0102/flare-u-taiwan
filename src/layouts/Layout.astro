---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'FLARE U Taiwan',
	description = '整理 FLARE U 的投票、行程、影音與成員資訊。',
} = Astro.props;

const pageTitle =
	title === 'FLARE U Taiwan'
		? title
		: `${title}｜FLARE U Taiwan`;

const siteUrl = 'https://flare-u-taiwan.vercel.app';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const shareImageUrl = new URL('/images/og-image.png', siteUrl).toString();
const isHomePage = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" />
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('flare-u-theme');
				const theme = saved === 'light' || saved === 'dark'
					? saved
					: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#081225' : '#ffffff');
			})();
		</script>

		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="zh_TW" />
		<meta property="og:site_name" content="FLARE U Taiwan" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="FLARE U Taiwan 台灣粉絲資訊站" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImageUrl} />
		<meta name="twitter:image:alt" content="FLARE U Taiwan 台灣粉絲資訊站" />

		{isHomePage && (
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: 'FLARE U Taiwan',
				alternateName: ['FLARE U 台灣粉絲資訊站', 'flare-u-taiwan.vercel.app'],
				url: `${siteUrl}/`,
			})} />
		)}

		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<title>{pageTitle}</title>
	</head>

	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>
